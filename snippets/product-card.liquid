{%- comment -%}
  Renders one product as a "hazard placard" card.
  Usage: {% render 'product-card', product: product, forloop: forloop %}
{%- endcomment -%}

{%- assign img_main = product.featured_image -%}
{%- assign img_alt = product.images[1] | default: img_main -%}
{%- assign code = product.id | modulo: 900 | plus: 100 -%}

<div class="hz-card">
  <div class="hz-card__corner"></div>

  <a href="{{ product.url }}" class="hz-card__media">
    {% if img_main %}
      <img class="main" src="{{ img_main | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">
      <img class="alt" src="{{ img_alt | image_url: width: 700 }}" alt="" loading="lazy">
    {% endif %}
    {% unless product.available %}
      <span class="hz-card__soldout">Sold Out</span>
    {% endunless %}
  </a>

  <div class="hz-card__data">
    <div class="hz-card__code">CODE {{ code }} / {{ product.type | default: 'UNCLASSIFIED' | upcase }}</div>
    <h3 class="hz-card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    <div class="hz-card__price-row">
      <span>
        {% if product.compare_at_price > product.price %}
          <span class="hz-card__price sale">{{ product.price | money }}</span>
        {% else %}
          <span class="hz-card__price">{{ product.price | money }}</span>
        {% endif %}
      </span>
      <span>{{ product.variants.size }} OPT</span>
    </div>

    {%- comment -%} signature element: hazard-index meter, derived from price tier {%- endcomment -%}
    {%- assign tier = product.price | divided_by: 20000 | at_most: 5 | at_least: 1 -%}
    <div class="hz-index">
      <span class="hz-index__label">HZRD IDX</span>
      {% for i in (1..5) %}
        <span class="hz-index__bar{% if i <= tier %} filled{% endif %}"></span>
      {% endfor %}
    </div>
  </div>
</div>
