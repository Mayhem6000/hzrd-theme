<div class="collection-intro">
  <div class="collection-intro__eyebrow">Bag</div>
  <h1 class="collection-intro__title">Your Bag</h1>
</div>
<div style="padding:32px;">
  {% if cart.item_count == 0 %}
    <p style="font-family:var(--font-mono);text-transform:uppercase;font-size:13px;color:#888;">Bag is empty.</p>
  {% else %}
    {% for item in cart.items %}
      <div style="display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--hzrd-line);font-family:var(--font-mono);font-size:13px;">
        <span>{{ item.product.title }} × {{ item.quantity }}</span>
        <span>{{ item.line_price | money }}</span>
      </div>
    {% endfor %}
  {% endif %}
</div>
{% schema %}{ "name": "Main cart", "settings": [] }{% endschema %}
