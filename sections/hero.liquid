<section class="hero">
  <div class="hero__tag">{{ section.settings.eyebrow | default: 'Collection 05 / In Stock Now' }}</div>
  {% if section.settings.heading != blank %}
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
  {% endif %}
  <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="hero__cta">
    {{ section.settings.button_label | default: 'Enter the Collection' }}
  </a>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
