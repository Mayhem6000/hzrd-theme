<div class="page-basic">
  <div class="page-basic__eyebrow">{{ page.title }}</div>
  <h1 class="page-basic__title">{{ section.settings.heading | default: page.title }}</h1>
  <div class="page-basic__body">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Basic page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading override" }
  ],
  "presets": [{ "name": "Basic page" }]
}
{% endschema %}
